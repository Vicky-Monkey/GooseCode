{
  "name": "goosecode",
  "version": "1.3.0",
  "private": true,
  "description": "Offline DNA transcription, protein translation and visual local alignment.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:browser:fasta": "node tests/multi-fasta-browser.cjs",
    "test:web": "node tests/static-web-browser.cjs",
